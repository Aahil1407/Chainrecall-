NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=chainrecall
DB_PASSWORD=replace-with-local-password
DB_NAME=chainrecall

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=replace-with-a-testnet-only-wallet-key
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
JWT_SECRET=replace-with-at-least-32-random-bytes

# Only required when running `npm run seed:manufacturers` locally.
SEED_ABC_EMAIL=abc@example.invalid
SEED_ABC_PASSWORD=replace-with-a-unique-password
SEED_PFIZER_EMAIL=pfizer@example.invalid
SEED_PFIZER_PASSWORD=replace-with-a-unique-password
